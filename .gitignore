models/
*.pt

# Local test photographs. These are inputs, not project assets, and the
# repository generates its own reproducible test scene via
# tools/make_sample.py. Keeping personal images out of a public history
# also avoids publishing them permanently.
chair.png
dice.jpg

# Exports land next to the source image by default, but catch the obvious
# cases if someone writes them into the project.
*_relit.png
*_gbuffer.zip
*_lighting.json
